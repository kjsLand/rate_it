{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rate_it",
  "version": "0.1.0",
  "identifier": "com.kevinland.rateit",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --dir ui dev",
    "beforeBuildCommand": "pnpm --dir ui build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "rate_it",
        "width": 1024,
        "height": 768,
        "minWidth": 360,
        "minHeight": 560,
        "backgroundColor": "#fef3f0"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://i.scdn.co; connect-src ipc: http://ipc.localhost",
      "capabilities": ["main-window"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "mobile": [{ "scheme": ["rateit"], "appLink": false }]
    }
  }
}
